#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    /* コンボは干渉を避けるため削除した状態を維持します */

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp W      &kp E         &kp R      &kp T    &kp Y      &kp U      &kp I      &kp O    &kp P
&kp A  &kp S      &kp D         &kp F      &kp G    &kp H      &kp J      &kp K      &kp L    &kp BACKSPACE
&kp Z  &kp X      &kp C         &kp V      &kp B    &kp N      &kp M      &kp COMMA  &kp DOT  &kp SLASH
&mo 1  &kp LSHFT  &kp LEFT_ALT  &kp LCTRL  &kp TAB  &kp SPACE  &kp ENTER  &kp BSPC   &kp TAB  &kp LC(SPACE)
            >;
        };

        layer_1 {
            bindings = <
&kp TILDE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_6          &kp N7                        &kp N8        &kp N9          &kp N0
&none      &none         &kp LPAR      &kp RPAR      &kp SLASH     &kp EQUAL             &kp N4                        &kp N5        &kp N6          &none
&none      &none         &none         &kp PRCNT     &kp PERIOD    &kp LEFT_PARENTHESIS  &kp LS(KP_RIGHT_PARENTHESIS)  &kp UP_ARROW  &kp UP_ARROW    &none
&none      &kp LSHFT     &none         &none         &none         &none                 &none                         &kp LEFT      &kp DOWN_ARROW  &kp LC(RIGHT_ARROW)
            >;
        };

        layer_2 {
            bindings = <
&bt BT_CLR    &bt BT_CLR_ALL  &none          &none          &none          &none           &none  &none           &none           &none
&bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3   &none          &none           &none  &none           &none           &none
&none         &bt BT_DISC 0   &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &msc SCRL_UP    &none  &none           &mmv MOVE_UP    &mkp LCLK
&none         &none           &none          &none          &none          &msc SCRL_DOWN  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
            >;
        };
    };
};
