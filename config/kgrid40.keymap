#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    /* コンボは干渉を避けるため削除した状態を維持します */

    behaviors {
        ime_ht: ime_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "IME_HT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q    &kp W      &kp E         &kp R      &kp T    &kp Y      &kp U      &kp I      &kp O                                      &kp P
&kp A    &kp S      &kp D         &kp F      &kp G    &kp H      &kp J      &kp K      &kp L                                      &kp BACKSPACE
&lt 2 Z  &kp X      &kp C         &kp V      &kp B    &kp N      &kp M      &kp COMMA  &kp DOT                                    &kp SLASH
&mo 1    &kp LSHFT  &kp LEFT_ALT  &kp LCTRL  &kp TAB  &kp SPACE  &kp ENTER  &kp BSPC   &ime_ht LANG_HIRAGANA LANG_ZENKAKUHANKAKU  &kp LC(DELETE)
            >;
        };

        layer_1 {
            bindings = <
&kp NUMBER_1      &kp NUMBER_2       &kp NUMBER_3   &kp NUMBER_4      &kp N5     &kp NUMBER_6    &kp N7        &kp N8           &kp N9         &kp N0
&kp EXCLAMATION   &kp QUESTION       &kp LPAR       &kp RPAR          &kp SLASH  &kp HOME        &kp UP_ARROW  &kp PAGE_UP      &kp PAGE_DOWN  &kp END
&kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LESS_THAN  &kp GREATER_THAN  &kp DOT    &kp LEFT_ARROW  &kp LS(DOWN)  &kp RIGHT_ARROW  &kp DEL        &kp MINUS
&none             &kp LSHFT          &kp LCTRL      &kp LEFT_ALT      &kp ESC    &kp SPACE       &kp ENTER     &kp BACKSPACE    &kp LS(Z)      &kp LC(Y)
            >;
        };

        layer_2 {
            bindings = <
&bt BT_CLR    &bt BT_CLR_ALL  &none          &none          &none          &none           &none  &none           &none           &none
&bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3   &none          &none           &none  &none           &none           &none
&none         &bt BT_DISC 0   &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &msc SCRL_UP    &none  &none           &mmv MOVE_UP    &mkp LCLK
&none         &none           &none          &none          &none          &msc SCRL_DOWN  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
            >;
        };
    };
};
